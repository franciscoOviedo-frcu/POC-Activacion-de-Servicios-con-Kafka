{
  "name": "activation-poc",
  "version": "1.0.0",
  "description": "POC Activación de Servicios con Kafka - UTN FRCU Sistemas Distribuidos",
  "private": true,
  "scripts": {
    "build": "nest build activation-api && nest build billing-service && nest build provisioning-service",
    "build:all": "nest build activation-api && nest build billing-service && nest build provisioning-service && nest build notification-service && nest build crm-analytics-service",
    "start:api": "nest start activation-api --watch",
    "start:billing": "nest start billing-service --watch",
    "start:provisioning": "nest start provisioning-service --watch",
    "start:notification": "nest start notification-service --watch",
    "start:crm": "nest start crm-analytics-service --watch"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.8",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^10.3.8",
    "@nestjs/microservices": "^10.3.8",
    "@nestjs/mongoose": "^10.0.6",
    "@nestjs/platform-express": "^10.3.8",
    "@nestjs/platform-socket.io": "^10.3.8",
    "@nestjs/websockets": "^10.3.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "kafkajs": "^2.2.4",
    "mongoose": "^8.3.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.11",
    "@types/uuid": "^9.0.8",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}
